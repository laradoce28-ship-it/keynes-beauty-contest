{
  "name": "keynes-beauty-contest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply keynes-beauty-contest --local",
    "db:migrate:remote": "wrangler d1 migrations apply keynes-beauty-contest --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "vite": "^5.4.10",
    "wrangler": "^4.158.0"
  }
}
